# Allow only the root-owned DSH Chromium binary to create the user namespaces
# required by Chromium's own Linux sandbox on Ubuntu 24.04+.
#
# Keep this narrow: do not disable Ubuntu's global unprivileged-userns
# restriction and do not launch the browser with --no-sandbox.
abi <abi/4.0>,
include <tunables/global>

profile dsh-chromium /opt/dsh-runtime/browsers/chromium-*/chrome-linux64/chrome flags=(default_allow) {
  userns,

  include if exists <local/dsh-chromium>
}
