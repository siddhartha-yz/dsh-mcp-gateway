[Unit]
Description=DeepSeek Harness Web Host for dsh-mcp-gateway
Documentation=https://github.com/siddhartha-yz/dsh-mcp-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dsh-agent
Group=dsh-agent
EnvironmentFile=/etc/dsh-mcp-gateway/dsh.env
Environment=PATH=/opt/dsh-runtime/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/bin
WorkingDirectory=/srv/dsh-workspace
ExecStart=/opt/dsh-runtime/node_modules/.bin/dsh web --patch /srv/dsh-mcp-gateway/deploy/dsh/chatgpt-bridge.cordis.yml --host 127.0.0.1 --port 3080
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/dsh-workspace /var/lib/dsh-harness

[Install]
WantedBy=multi-user.target
