# Copy to /etc/dsh-mcp-gateway/dsh.env and chmod 0600.
# Primary ChatGPT -> DSH Harness operation requires no model-provider key.
DSH_HOME=/var/lib/dsh-harness
DSH_TELEMETRY_DISABLED=1
# Same exact public HTTPS origin as gateway.env; used to render remote-worker invites.
DSH_MCP_PUBLIC_BASE_URL=https://dsh.example.com

# Optional: used only when deploy/dsh/local-shell-mcp.cordis.yml is enabled.
# DSH_LSM_COMMAND=/opt/local-shell-mcp/.venv/bin/local-shell-mcp
# DSH_LSM_WORKSPACE_ROOT=/srv/dsh-workspace
# DSH_LSM_STATE_DIR=/var/lib/dsh-harness/local-shell-mcp
# DSH_LSM_AUDIT_LOG_PATH=/var/lib/dsh-harness/local-shell-mcp/audit.jsonl
# DSH_LSM_AGENT_CONFIG_DIR=/var/lib/dsh-harness/local-shell-mcp/agent_config
